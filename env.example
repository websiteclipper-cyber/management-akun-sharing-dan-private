# Existing application configuration
NEXT_PUBLIC_SUPABASE_URL=
# Publishable API key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret API key (sb_secret_...), never a publishable key or legacy JWT
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
ENCRYPTION_KEY=
BUYER_BAN_HASH_SECRET=
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Payment provider for new checkouts. Existing transactions retain their original provider.
PAYMENT_GATEWAY=kipay

# KiPay server credentials (never prefix these with NEXT_PUBLIC_).
# Sandbox/production use the same API URL; the project's API key determines the mode.
KIPAY_API_KEY=
KIPAY_WEBHOOK_SECRET=
KIPAY_ENV=sandbox
# Configure this URL in KiPay Dashboard > Project & Webhook:
# https://YOUR_PUBLIC_DOMAIN/api/webhooks/kipay

# Legacy KlikQRIS server credentials (never prefix these with NEXT_PUBLIC_)
KLIKQRIS_API_KEY=
KLIKQRIS_MERCHANT_ID=

# Use sandbox while testing. Change to production only after a successful sandbox test.
KLIKQRIS_ENV=sandbox

# Must be publicly accessible by KlikQRIS.
KLIKQRIS_CALLBACK_URL=https://pastipremium.my.id/api/webhooks/klikqris
